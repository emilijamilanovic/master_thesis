# Copy to .env and fill in real values.  .env is git-ignored; this file is not.
# run_pipeline.py and pipeline/tools/check_providers.py load .env automatically.
# For manual script runs:  set -a; source .env; set +a

# --- Chat providers -------------------------------------------------------
# OPENAI_API_KEY is the default provider and is required unless you pass
# --provider. Select another at run time: --provider anthropic|gemini|fireworks
# Verify a provider works:  .venv/bin/python pipeline/tools/check_providers.py

OPENAI_API_KEY=         # DEFAULT provider (GPT-4o / 4.1); also used for embeddings
ANTHROPIC_API_KEY=      # Claude haiku / sonnet / opus
GEMINI_API_KEY=         # Gemini 3.x flash / pro
FIREWORKS_API_KEY=      # GLM, DeepSeek, Kimi, gpt-oss

# --- Legacy ---------------------------------------------------------------
# Used by the original Llama-3.3-70B runs. Without it, those exact runs
# cannot be reproduced (no provider below currently serves that model).
HYPERBOLIC_API_KEY=
